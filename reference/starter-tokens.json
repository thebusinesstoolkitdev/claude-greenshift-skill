   "admincss": ".editor-styles-wrapper h6{font-family:var(--gt-font-body);font-size:var(--gt-small);font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:var(--gt-text,#33291f);}"
  },
  {
   "selector": "body",
   "css": "html body{font-family:var(--gt-font-body);font-size:var(--gt-body);line-height:1.65;color:var(--gt-text,#33291f);min-block-size:100svh;overflow-x:clip;}",
   "admincss": ".editor-styles-wrapper{font-family:var(--gt-font-body);font-size:var(--gt-body);line-height:1.65;color:var(--gt-text,#33291f);}"
  },
  {
   "selector": "a",
   "css": "body a:where(:not([class*=\"btn\"])){color:var(--gt-primary,#7e5aa6);text-underline-offset:0.15em;transition:color var(--gt-transition,0.2s ease);}@media(hover:hover) and (pointer:fine){body a:where(:not([class*=\"btn\"])):hover{color:var(--gt-primary-dark,#6a4a8f);}}body a[target=\"_blank\"]:where(:not(:has(img,figure,picture,svg)))::after{content:\"↗︎\" / \"\";font-size:0.8em;line-height:1;margin-inline-start:0.15em;color:currentColor;white-space:nowrap;}",
   "admincss": ""
  },
  {
   "selector": "p",
   "css": "body p{line-height:calc(1ex + 1.1em);text-wrap:pretty;}",
   "admincss": ""
  }
