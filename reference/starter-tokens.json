 "elements": [
  {
   "selector": "base",
   "css": "*,*::before,*::after{box-sizing:border-box;}:root{interpolate-size:allow-keywords;}html{scroll-behavior:smooth;}html:focus-within{scroll-behavior:auto;}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto;}}",
   "admincss": ""
  },
  {
   "selector": "h1",
   "css": "body h1{font-family:var(--gt-font-heading);font-size:var(--gt-h1);font-weight:600;line-height:1.08;letter-spacing:-0.01em;color:var(--gt-text,#33291f);text-wrap:balance;}",
   "admincss": ".editor-styles-wrapper h1{font-family:var(--gt-font-heading);font-size:var(--gt-h1);font-weight:600;line-height:1.08;letter-spacing:-0.01em;color:var(--gt-text,#33291f);}"
  },
