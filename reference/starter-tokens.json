   "selector": "h5",
   "css": "body h5{font-family:var(--gt-font-body);font-size:var(--gt-h5,1rem);font-weight:600;line-height:1.4;color:var(--gt-text,#33291f);}",
   "admincss": ".editor-styles-wrapper h5{font-family:var(--gt-font-body);font-size:1rem;font-weight:600;line-height:1.4;color:var(--gt-text,#33291f);}"
  },
