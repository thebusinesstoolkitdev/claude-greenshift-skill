 "elements": [
  {
   "selector": "h1",
   "css": "body h1{font-family:var(--gt-font-heading);font-size:var(--gt-h1);font-weight:600;line-height:1.08;letter-spacing:-0.01em;color:var(--gt-ink,#33291f);text-wrap:balance;}",
   "admincss": ".editor-styles-wrapper h1{font-family:var(--gt-font-heading);font-size:var(--gt-h1);font-weight:600;line-height:1.08;letter-spacing:-0.01em;color:var(--gt-ink,#33291f);}"
  },
  {
   "selector": "h2",
   "css": "body h2{font-family:var(--gt-font-heading);font-size:var(--gt-h2);font-weight:600;line-height:1.15;letter-spacing:-0.01em;color:var(--gt-ink,#33291f);text-wrap:balance;}",
   "admincss": ".editor-styles-wrapper h2{font-family:var(--gt-font-heading);font-size:var(--gt-h2);font-weight:600;line-height:1.15;letter-spacing:-0.01em;color:var(--gt-ink,#33291f);}"
  },
  {
   "selector": "h3",
   "css": "body h3{font-family:var(--gt-font-heading);font-size:var(--gt-h3);font-weight:600;line-height:1.3;color:var(--gt-ink,#33291f);text-wrap:balance;}",
   "admincss": ".editor-styles-wrapper h3{font-family:var(--gt-font-heading);font-size:var(--gt-h3);font-weight:600;line-height:1.3;color:var(--gt-ink,#33291f);}"
  },
  {
   "selector": "h4",
   "css": "body h4{font-family:var(--gt-font-heading);font-size:1.1rem;font-weight:600;line-height:1.35;color:var(--gt-ink,#33291f);}",
   "admincss": ".editor-styles-wrapper h4{font-family:var(--gt-font-heading);font-size:1.1rem;font-weight:600;line-height:1.35;color:var(--gt-ink,#33291f);}"
  },
  {
   "selector": "h5",
   "css": "body h5{font-family:var(--gt-font-body);font-size:1rem;font-weight:600;line-height:1.4;color:var(--gt-ink,#33291f);}",
   "admincss": ".editor-styles-wrapper h5{font-family:var(--gt-font-body);font-size:1rem;font-weight:600;line-height:1.4;color:var(--gt-ink,#33291f);}"
  },
  {
   "selector": "h6",
