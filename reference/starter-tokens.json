   "css": "body h4{font-family:var(--gt-font-heading);font-size:var(--gt-h4,1.1rem);font-weight:600;line-height:1.35;color:var(--gt-text,#33291f);}",
   "admincss": ".editor-styles-wrapper h4{font-family:var(--gt-font-heading);font-size:1.1rem;font-weight:600;line-height:1.35;color:var(--gt-text,#33291f);}"
